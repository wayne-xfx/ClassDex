DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
PORT=5000
SESSION_SECRET="replace-with-a-long-random-string"
FRONTEND_ORIGIN="http://localhost:5173"
APP_BASE_URL="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"
CLIENT_URL="http://localhost:5173"
RECAPTCHA_SECRET_KEY=
RESET_TOKEN_TTL_MINUTES=30
VERIFY_TOKEN_TTL_HOURS=24
VERIFY_RESEND_COOLDOWN_SECONDS=60
TRUST_PROXY=1
# Mail transport configuration:
# - EMAIL_MODE: "resend" (live Resend API), "log" (console output only), or "stub" (in-memory capture for tests).
#   Tests (npm test / NODE_ENV=test) always default to "stub". When unset outside tests, uses "resend" if
#   RESEND_API_KEY and a verified EMAIL_FROM are configured, otherwise falls back to "log".
# - Domain verification: EMAIL_FROM must use a domain verified in Resend (e.g. classdex.me). Before verification,
#   Resend only allows sending from onboarding@resend.dev to the account owner's email (403 for other recipients).
# - Bounce & reputation safety: When EMAIL_MODE=resend, ONLY send to your own real email (or +tag aliases) or
#   delivered@resend.dev. Never send live Resend emails to fake addresses (@example.com, @test.local).
EMAIL_MODE="log"
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM="ClassDex <no-reply@classdex.me>"
