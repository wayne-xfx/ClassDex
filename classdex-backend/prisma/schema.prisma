generator client {
  provider = "prisma-client-js"
}

// Connection URL lives in prisma.config.ts via env("DATABASE_URL").
datasource db {
  provider = "postgresql"
}

enum Role {
  FACULTY
  STUDENT
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
}

enum RecitationMethod {
  RANDOM
  WEIGHTED
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  password       String
  role           Role
  createdAt      DateTime        @default(now())
  facultyProfile FacultyProfile?
  studentProfile StudentProfile?
  classes        Class[]         @relation("FacultyClasses")
}

model FacultyProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  name       String?
  department String?
  photo      String?  @db.Text
  email      String?
  contact    String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model StudentProfile {
  id          String             @id @default(cuid())
  userId      String             @unique
  name        String
  address     String?
  program     String?
  section     String?
  studentId   String             @unique
  photo       String             @db.Text
  email       String
  birthdate   DateTime?          @db.Date
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments ClassEnrollment[]
  attendance  AttendanceRecord[]
  recitations RecitationLog[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model Class {
  id                 String            @id @default(cuid())
  sectionName        String
  classCode          String            @unique
  description        String?
  schedule           String?
  gracePeriodMinutes Int               @default(15)
  facultyId          String
  faculty            User              @relation("FacultyClasses", fields: [facultyId], references: [id], onDelete: Cascade)
  enrollments        ClassEnrollment[]
  sessions           ClassSession[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model ClassEnrollment {
  id               String         @id @default(cuid())
  studentProfileId String
  classId          String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  class            Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  joinedAt         DateTime       @default(now())

  @@unique([studentProfileId, classId])
}

model ClassSession {
  id          String             @id @default(cuid())
  classId     String
  date        DateTime           @db.Date
  startedAt   DateTime           @default(now())
  endedAt     DateTime?
  class       Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  attendance  AttendanceRecord[]
  recitations RecitationLog[]

  @@unique([classId, date])
}

model AttendanceRecord {
  id             String           @id @default(cuid())
  sessionId      String
  studentId      String
  status         AttendanceStatus
  markedAt       DateTime         @default(now())
  session        ClassSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([sessionId, status])
}

model RecitationLog {
  id             String           @id @default(cuid())
  sessionId      String
  studentId      String
  method         RecitationMethod
  calledAt       DateTime         @default(now())
  score          Int?
  session        ClassSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([sessionId, calledAt])
  @@index([studentId])
}
