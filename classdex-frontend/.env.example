# Unsigned Cloudinary upload configuration for profile photos.
# When both variables are set, photos upload to Cloudinary (upload errors are shown instead of falling back to inline data).
# When omitted in local development, selected images fall back to a local data URL in the profile record.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_RECAPTCHA_SITE_KEY=
